[sub_resource type="GDScript" id="GDScript_jxnhf"]
script/source = "extends CardModuleProperty

class_name CardModuleDamageInfoProperty

@export var damageTypeOptions : OptionButton
@export var calcOptions : OptionButton
@export var selfcalcOptions : OptionButton

func _ready() -> void:
	for g in CardModule.Stat.size():
		var key = CardModule.Stat.keys()[g]
		damageTypeOptions.add_item(key)
	
	for g in DamageInfo.CalcuationMethod.size():
		var key = DamageInfo.CalcuationMethod.keys()[g]
		calcOptions.add_item(key)
	
	for g in DamageInfo.SelfCalcuationMethod.size():
		var key = DamageInfo.SelfCalcuationMethod.keys()[g]
		selfcalcOptions.add_item(key)
"

